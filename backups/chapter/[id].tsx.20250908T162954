import { useLanguage } from "@/context/LanguageContext";
import { useLocalSearchParams } from "expo-router";
import React, { useCallback, useEffect, useMemo, useState } from "react";
import {
  ActivityIndicator,
  FlatList,
  StyleSheet,
  Text,
  TouchableOpacity,
  View,
} from "react-native";

type Chapter = {
  chapter?: string;
  title?: string;
  summary?: string;
  lang?: string;
  audioUrl?: string;
  SanskritChapterAudioUrl?: string;
};

type Verse = {
  id: string;
  verse?: number;
  sanskrit?: string;
  translation?: string;
  audioUrl?: string;
};

export default function ChapterPage() {
  const params = useLocalSearchParams() as Record<string, string | undefined>;
  const fetchId = params.id ?? params.chapter ?? null;
  const { lang } = useLanguage();

  // Correct endpoint for chapter metadata
  const chapterEndpoint = useMemo(() => {
    if (!fetchId) return null;
    return `https://eq21.co.in/_functions/chapter?chapter=${encodeURIComponent(
      String(fetchId)
    )}&lang=${encodeURIComponent(lang)}`;
  }, [fetchId, lang]);

  const [loadingChapter, setLoadingChapter] = useState(false);
  const [chapter, setChapter] = useState<Chapter | null>(null);
  const [chapterError, setChapterError] = useState<string | null>(null);

  const [verses, setVerses] = useState<Verse[]>([]);
  const [loadingVerses, setLoadingVerses] = useState(false);
  const [versesError, setVersesError] = useState<string | null>(null);

  const fetchChapter = useCallback(async () => {
    if (!chapterEndpoint) {
      setChapterError("Missing chapter id");
      return;
    }
    setLoadingChapter(true);
    setChapterError(null);
    try {
      console.log("[chapterPage] fetching chapter", chapterEndpoint);
      const res = await fetch(chapterEndpoint);
      console.log("[chapterPage] response status", res.status);
      const text = await res.text().catch(() => "<no body>");
      console.log("[chapterPage] response body", text);
      if (!res.ok) {
        throw new Error(`HTTP ${res.status} ${res.statusText} ${text}`);
      }
      const json = JSON.parse(text);
      setChapter(json);
    } catch (err: any) {
      console.error("[chapterPage] fetch error", err);
      setChapterError(err.message ?? String(err));
    } finally {
      setLoadingChapter(false);
    }
  }, [chapterEndpoint]);

  const fetchVerses = useCallback(async () => {
    if (!fetchId) {
      setVersesError("Missing chapter id");
      return;
    }
    setLoadingVerses(true);
    setVersesError(null);
    try {
      const params = new URLSearchParams({
        chapter: String(fetchId),
        lang: lang,    // or use 'lang': lang if your backend expects that
        skip: "0",
        limit: "20",
      });
      const versesUrl = `https://eq21.co.in/_functions/shlokas?${params.toString()}`;

      console.log("[chapterPage] fetching verses", versesUrl);
      const res = await fetch(versesUrl);
      console.log("[chapterPage] verses response status", res.status);
      const text = await res.text().catch(() => "<no body>");
      console.log("[chapterPage] verses response body", text);
      if (!res.ok) throw new Error(`HTTP ${res.status} ${res.statusText} ${text}`);
      const json = JSON.parse(text);
      const list = Array.isArray(json.verses) ? json.verses : Array.isArray(json) ? json : [];
      setVerses(list as Verse[]);
    } catch (err: any) {
      console.error("[chapterPage] verses fetch error", err);
      setVersesError(err.message ?? String(err));
    } finally {
      setLoadingVerses(false);
    }
  }, [fetchId, lang]);

  useEffect(() => {
    fetchChapter();
  }, [fetchChapter]);

  return (
    <View style={styles.container}>
      <Text style={styles.header}>Chapter</Text>

      {loadingChapter ? (
        <View style={styles.center}>
          <ActivityIndicator />
          <Text>Loading chapter…</Text>
        </View>
      ) : chapterError ? (
        <View style={styles.center}>
          <Text style={styles.error}>Unable to load chapter. {chapterError}</Text>
          <TouchableOpacity style={styles.button} onPress={fetchChapter}>
            <Text style={styles.buttonText}>Retry</Text>
          </TouchableOpacity>
        </View>
      ) : chapter ? (
        <View style={styles.card}>
          <Text style={styles.title}>{chapter.title ?? `Chapter ${fetchId}`}</Text>
          {chapter.SanskritChapterAudioUrl ? (
            <Text style={{ marginTop: 8 }}>Audio: {chapter.SanskritChapterAudioUrl}</Text>
          ) : null}
          {chapter.lang ? <Text style={styles.summary}>lang: {chapter.lang}</Text> : null}

          <TouchableOpacity
            style={[styles.button, { marginTop: 16 }]}
            onPress={fetchVerses}
            disabled={loadingVerses}
          >
            <Text style={styles.buttonText}>
              {loadingVerses ? "Loading verses..." : "Load Verses"}
            </Text>
          </TouchableOpacity>

          {versesError ? (
            <View style={{ marginTop: 12 }}>
              <Text style={styles.error}>Unable to load verses: {versesError}</Text>
            </View>
          ) : null}

          {verses.length > 0 ? (
            <FlatList
              style={{ marginTop: 16 }}
              data={verses}
              keyExtractor={(i) => i.id ?? String(i.verse ?? Math.random())}
              renderItem={({ item }) => (
                <View style={styles.verseCard}>
                  {item.sanskrit ? <Text style={styles.sanskrit}>{item.sanskrit}</Text> : null}
                  {item.translation ? (
                    <Text style={styles.translation}>{item.translation}</Text>
                  ) : null}
                </View>
              )}
              ListHeaderComponent={<Text style={{ fontWeight: "600" }}>{`Verses (${verses.length})`}</Text>}
            />
          ) : null}
        </View>
      ) : (
        <View style={styles.center}>
          <Text>No chapter data.</Text>
        </View>
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, paddingTop: 16, paddingHorizontal: 12 },
  header: { fontSize: 20, fontWeight: "700", alignSelf: "center", marginBottom: 12 },
  center: { alignItems: "center", justifyContent: "center", padding: 24 },
  card: { padding: 12, borderRadius: 8, backgroundColor: "#fff" },
  title: { fontSize: 18, fontWeight: "600" },
  summary: { marginTop: 8, color: "#444" },
  button: {
    marginTop: 8,
    paddingVertical: 10,
    paddingHorizontal: 14,
    borderRadius: 8,
    backgroundColor: "#007AFF",
    alignSelf: "flex-start",
  },
  buttonText: { color: "#fff", fontWeight: "600" },
  error: { color: "red" },
  verseCard: { paddingVertical: 8, borderBottomWidth: 1, borderColor: "#eee" },
  sanskrit: { fontSize: 16 },
  translation: { marginTop: 6, color: "#333" },
});
