// components/AppHeader.tsx
import { useRouter, useSegments } from "expo-router";
import React, { useCallback, useState } from "react";
import {
  Platform,
  SafeAreaView,
  StyleSheet,
  Text,
  TouchableOpacity,
  View,
} from "react-native";
import { useLanguage } from "../context/LanguageContext";
import LanguageModal from "./LanguageModal";

type AppHeaderProps = {
  title?: string;
  onMenuPress?: () => void;
};

export default function AppHeader({ title = "Gita App", onMenuPress }: AppHeaderProps) {
  const { langName } = useLanguage();
  const [pickerVisible, setPickerVisible] = useState(false);
  const router = useRouter();
  const segments = useSegments();

  const canGoBack = Array.isArray(segments) && segments.length > 1;

  const onBackPress = useCallback(() => {
    try {
      router.back();
    } catch (e) {
      console.log("router.back failed", e);
    }
  }, [router]);

  return (
    <>
      <SafeAreaView style={styles.safe}>
        <View style={styles.header}>
          <View style={styles.leftContainer}>
            {canGoBack ? (
              <TouchableOpacity onPress={onBackPress} style={styles.iconButton}>
                <Text style={styles.iconText}>←</Text>
              </TouchableOpacity>
            ) : (
              <TouchableOpacity onPress={onMenuPress} style={styles.iconButton}>
                <Text style={styles.iconText}>☰</Text>
              </TouchableOpacity>
            )}
          </View>

          <View style={styles.centerContainer}>
            <Text style={styles.title} numberOfLines={1}>
              {title}
            </Text>
          </View>

          <View style={styles.rightContainer}>
            <TouchableOpacity onPress={() => setPickerVisible(true)} style={styles.langButton}>
              <Text style={styles.langText}>{langName} ▾</Text>
            </TouchableOpacity>
          </View>
        </View>
      </SafeAreaView>

      <LanguageModal visible={pickerVisible} onClose={() => setPickerVisible(false)} />
    </>
  );
}

const styles = StyleSheet.create({
  safe: { backgroundColor: "#fff" },
  header: {
    height: Platform.OS === "ios" ? 56 : 56,
    flexDirection: "row",
    alignItems: "center",
    paddingHorizontal: 8,
    borderBottomWidth: 1,
    borderColor: "#eee",
    justifyContent: "space-between",
  },
  leftContainer: { width: 60, alignItems: "flex-start" },
  centerContainer: { flex: 1, paddingHorizontal: 8, alignItems: "center" },
  rightContainer: { width: 120, alignItems: "flex-end" },
  iconButton: { padding: 8 },
  iconText: { fontSize: 18 },
  title: { fontSize: 18, fontWeight: "600" },
  langButton: {
    paddingVertical: 6,
    paddingHorizontal: 10,
    borderRadius: 6,
    borderWidth: 1,
    borderColor: "#ddd",
  },
  langText: { fontSize: 14, fontWeight: "500" },
});
