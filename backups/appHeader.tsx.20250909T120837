// app/components/AppHeader.tsx
import { useRouter } from "expo-router";
import React, { useState } from "react";
import {
  Dimensions,
  Modal,
  Platform,
  Pressable,
  StatusBar,
  StyleSheet,
  Text,
  TouchableOpacity,
  View
} from "react-native";

/**
 * AppHeader
 * - Safe top spacing to avoid notch overlap
 * - Hamburger (left), centered title, right placeholder
 * - Hamburger hitSlop increased so it's tappable near notch
 * - Modal menu with small icons (emoji-based to avoid new deps)
 */

const TOP_PADDING = Platform.OS === "ios" ? 44 : (StatusBar.currentHeight ?? 12);
const WINDOW_WIDTH = Dimensions.get("window").width;

type Props = {
  title?: string;
};

export default function AppHeader({ title = "Gita App" }: Props) {
  const [menuVisible, setMenuVisible] = useState(false);
  const router = useRouter();

  const openMenu = () => setMenuVisible(true);
  const closeMenu = () => setMenuVisible(false);

  const nav = (path: string) => {
    closeMenu();
    setTimeout(() => router.push(path), 85);
  };

  // increase tappable area for the hamburger
  const hitSlop = { top: 14, bottom: 14, left: 14, right: 14 };

  return (
    <>
      <View style={styles.header}>
        <TouchableOpacity
          accessibilityLabel="Open menu"
          onPress={openMenu}
          hitSlop={hitSlop}
          style={styles.hamburger}
        >
          <Text style={styles.hamburgerText}>☰</Text>
        </TouchableOpacity>

        <View style={styles.titleWrap}>
          <Text numberOfLines={1} style={styles.title}>
            {title}
          </Text>
        </View>

        <View style={styles.rightPlaceholder} />
      </View>

      <Modal
        visible={menuVisible}
        animationType="fade"
        transparent
        onRequestClose={closeMenu}
      >
        <Pressable style={styles.modalOverlay} onPress={closeMenu}>
          <View style={styles.menuCard}>
            <Text style={styles.menuTitle}>Menu</Text>

            <TouchableOpacity style={styles.menuItem} onPress={() => nav("/")} accessibilityRole="button">
              <Text style={styles.menuIcon}>🏠</Text>
              <Text style={styles.menuItemText}>Home</Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={styles.menuItem}
              onPress={() => nav("/human-dilemma")}
              accessibilityRole="button"
            >
              <Text style={styles.menuIcon}>🧭</Text>
              <Text style={styles.menuItemText}>Human Dilemma</Text>
            </TouchableOpacity>

            <TouchableOpacity style={styles.menuItem} onPress={() => nav("/about")} accessibilityRole="button">
              <Text style={styles.menuIcon}>ℹ️</Text>
              <Text style={styles.menuItemText}>About</Text>
            </TouchableOpacity>

            <View style={styles.menuFooter}>
              <TouchableOpacity style={styles.closeBtn} onPress={closeMenu}>
                <Text style={styles.closeText}>Close</Text>
              </TouchableOpacity>
            </View>
          </View>
        </Pressable>
      </Modal>
    </>
  );
}

const styles = StyleSheet.create({
  header: {
    paddingTop: TOP_PADDING,
    height: TOP_PADDING + 52,
    paddingHorizontal: 12,
    flexDirection: "row",
    alignItems: "center",
    borderBottomWidth: StyleSheet.hairlineWidth,
    borderBottomColor: "#e6e6e6",
    backgroundColor: "#fff",
    zIndex: 1000,
    elevation: 8,
  },
  hamburger: {
    width: 44,
    height: 44,
    alignItems: "center",
    justifyContent: "center",
  },
  hamburgerText: {
    fontSize: 20,
  },
  titleWrap: {
    flex: 1,
    alignItems: "center",
    justifyContent: "center",
    maxWidth: WINDOW_WIDTH - 200,
  },
  title: { fontSize: 18, fontWeight: "700" },
  rightPlaceholder: { width: 44 },

  modalOverlay: {
    flex: 1,
    backgroundColor: "rgba(0,0,0,0.35)",
    justifyContent: "center",
    padding: 24,
  },
  menuCard: {
    backgroundColor: "#fff",
    borderRadius: 10,
    paddingVertical: 12,
    paddingHorizontal: 14,
    elevation: 6,
  },
  menuTitle: { fontSize: 18, fontWeight: "700", marginBottom: 8, paddingHorizontal: 4 },

  menuItem: {
    flexDirection: "row",
    alignItems: "center",
    paddingVertical: 10,
    paddingHorizontal: 4,
  },
  menuIcon: { fontSize: 20, width: 34 },
  menuItemText: { fontSize: 16, marginLeft: 6 },

  menuFooter: {
    marginTop: 8,
    alignItems: "flex-end",
  },

  closeBtn: {
    paddingHorizontal: 12,
    paddingVertical: 8,
  },
  closeText: { color: "#007AFF", fontWeight: "600" },
});
