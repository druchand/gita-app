// app/components/AppHeader.tsx
import { useRouter } from "expo-router";
import React, { useState } from "react";
import {
  Modal,
  Platform,
  Pressable,
  StyleSheet,
  Text,
  TouchableOpacity,
  View,
} from "react-native";

/**
 * Simple AppHeader with:
 * - Hamburger button (left)
 * - Title (center)
 * - Optional right area (you can keep language button there from index)
 *
 * When hamburger pressed -> open a Modal that lists navigation targets:
 * Home, Human Dilemma, About
 *
 * This keeps behavior explicit and avoids relying on external drawer libraries.
 */

type Props = {
  title?: string;
};

export default function AppHeader({ title = "Gita App" }: Props) {
  const [menuVisible, setMenuVisible] = useState(false);
  const router = useRouter();

  const openMenu = () => setMenuVisible(true);
  const closeMenu = () => setMenuVisible(false);

  const nav = (path: string) => {
    closeMenu();
    // small delay so modal closes first (smoother UX)
    setTimeout(() => {
      router.push(path);
    }, 50);
  };

  return (
    <>
      <View style={styles.header}>
        <TouchableOpacity accessibilityLabel="Open menu" onPress={openMenu} style={styles.hamburger}>
          <Text style={styles.hamburgerText}>☰</Text>
        </TouchableOpacity>

        <View style={styles.titleWrap}>
          <Text numberOfLines={1} style={styles.title}>
            {title}
          </Text>
        </View>

        {/* Right side placeholder (keeps header symmetric) */}
        <View style={styles.rightPlaceholder} />
      </View>

      <Modal
        visible={menuVisible}
        animationType="fade"
        transparent
        onRequestClose={closeMenu}
      >
        <Pressable style={styles.modalOverlay} onPress={closeMenu}>
          <View style={styles.menuCard}>
            <Text style={styles.menuTitle}>Menu</Text>

            <TouchableOpacity
              style={styles.menuItem}
              onPress={() => nav("/")}
              accessibilityRole="button"
            >
              <Text style={styles.menuItemText}>Home</Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={styles.menuItem}
              onPress={() => nav("/human-dilemma")}
              accessibilityRole="button"
            >
              <Text style={styles.menuItemText}>Human Dilemma</Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={styles.menuItem}
              onPress={() => nav("/about")}
              accessibilityRole="button"
            >
              <Text style={styles.menuItemText}>About</Text>
            </TouchableOpacity>

            <TouchableOpacity style={styles.closeBtn} onPress={closeMenu}>
              <Text style={styles.closeText}>Close</Text>
            </TouchableOpacity>
          </View>
        </Pressable>
      </Modal>
    </>
  );
}

const styles = StyleSheet.create({
  header: {
    height: Platform.OS === "ios" ? 64 : 56,
    paddingTop: Platform.OS === "ios" ? 18 : 8,
    paddingHorizontal: 12,
    flexDirection: "row",
    alignItems: "center",
    borderBottomWidth: StyleSheet.hairlineWidth,
    borderBottomColor: "#e6e6e6",
    backgroundColor: "#fff",
  },
  hamburger: {
    width: 40,
    height: 40,
    alignItems: "center",
    justifyContent: "center",
  },
  hamburgerText: {
    fontSize: 20,
  },
  titleWrap: {
    flex: 1,
    alignItems: "center",
    justifyContent: "center",
  },
  title: { fontSize: 18, fontWeight: "700" },
  rightPlaceholder: { width: 40 },

  modalOverlay: {
    flex: 1,
    backgroundColor: "rgba(0,0,0,0.35)",
    justifyContent: "center",
    padding: 24,
  },
  menuCard: {
    backgroundColor: "#fff",
    borderRadius: 10,
    padding: 18,
    elevation: 6,
  },
  menuTitle: { fontSize: 18, fontWeight: "700", marginBottom: 12 },
  menuItem: { paddingVertical: 10 },
  menuItemText: { fontSize: 16 },
  closeBtn: {
    marginTop: 12,
    alignSelf: "flex-end",
    paddingHorizontal: 12,
    paddingVertical: 8,
  },
  closeText: { color: "#007AFF", fontWeight: "600" },
});
