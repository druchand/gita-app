+/**
+ * Defensive helper: try to extract a hook/function from a module namespace by several candidate names.
+ * Returns undefined if nothing found.
+ */
+function findExport(mod: any, candidates: string[]) {
+  if (!mod) return undefined;
+  for (const name of candidates) {
+    if (typeof mod[name] === "function") return mod[name];
+  }
+  return undefined;
+}
+
+/**
+ * Safely require a module namespace if available. Uses require() to avoid TS import-time cycles.
+ * Returns undefined if the module cannot be loaded.
+ */
+function tryRequire(path: string): any | undefined {
+  try {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const m = require(path);
+    return m;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
