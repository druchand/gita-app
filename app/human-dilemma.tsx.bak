// app/human-dilemma.tsx
import { useLanguage } from "@/context/LanguageContext";
import React, { useEffect, useState } from "react";
import { ActivityIndicator, StyleSheet, Text, View } from "react-native";

export default function HumanDilemma(): JSX.Element {
  const { lang } = useLanguage();

  // normalize lang and derive langName defensively
  const safeLang = typeof lang === "string" ? lang : (lang && (lang as any).code) ?? "EN";
  const langName =
    typeof lang === "string" ? (safeLang === "HI" ? "Hindi" : "English") : (lang as any)?.name ?? "English";

  const [loading, setLoading] = useState(false);
  const [data, setData] = useState<any | null>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    async function fetchList() {
      setLoading(true);
      setError(null);
      try {
        const url = `https://eq21.co.in/_functions/dilemmaList?lang=${encodeURIComponent(safeLang)}`;
        console.debug("[dilemma] fetch list", url);
        const res = await fetch(url);
        if (!res.ok) {
          const text = await res.text().catch(() => "");
          throw new Error(`HTTP ${res.status} ${text}`);
        }
        const json = await res.json().catch(() => null);
        setData(json);
      } catch (err: any) {
        console.error("[dilemma] fetch error", err);
        setError(String(err?.message ?? err));
      } finally {
        setLoading(false);
      }
    }
    fetchList();
  }, [safeLang]);

  if (loading) {
    return (
      <View style={styles.center}>
        <ActivityIndicator />
        <Text>Loading...</Text>
      </View>
    );
  }

  if (error) {
    return (
      <View style={styles.center}>
        <Text style={{ color: "red" }}>Error: {error}</Text>
      </View>
    );
  }

  return (
    <View style={{ padding: 16 }}>
      <Text style={styles.title}>Human Dilemma ({langName})</Text>
      <Text style={{ marginTop: 12 }}>{data?.description ?? "No data yet"}</Text>
    </View>
  );
}

const styles = StyleSheet.create({
  center: { flex: 1, alignItems: "center", justifyContent: "center", padding: 24 },
  title: { fontSize: 18, fontWeight: "700" },
});